{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI/LLM-agnostic audit state",
  "type": "object",
  "required": ["run_id", "as_of_date", "inputs", "findings"],
  "properties": {
    "run_id": {"type": "string"},
    "as_of_date": {"type": "string", "format": "date"},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["classification", "confidence", "evidence"]}}
  }
}
