{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assembled offline review input",
  "type": "object",
  "required": [
    "property",
    "as_of",
    "start",
    "days",
    "reservations",
    "inventory"
  ],
  "properties": {
    "property": {
      "$ref": "property.json"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "start": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "integer",
      "minimum": 1
    },
    "rate_plans": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reservations": {
      "type": "array",
      "items": {
        "$ref": "reservations.json"
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "$ref": "inventory.json"
      }
    },
    "rates": {
      "type": "array",
      "items": {
        "$ref": "published_rates.json"
      }
    }
  }
}
