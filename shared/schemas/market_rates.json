{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized market rate observation",
  "type": "object",
  "required": ["observed_at", "stay_date", "room_type", "property_rate", "comp_median_rate"],
  "properties": {
    "observed_at": {"type": "string", "format": "date-time"},
    "stay_date": {"type": "string", "format": "date"},
    "room_type": {"type": "string"},
    "property_rate": {"type": "number", "minimum": 0},
    "comp_median_rate": {"type": "number", "minimum": 0},
    "comp_count": {"type": "integer", "minimum": 0}
  }
}
